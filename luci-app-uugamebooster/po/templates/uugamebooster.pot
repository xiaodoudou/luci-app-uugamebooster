#: luci-app-uugamebooster/luasrc/model/cbi/uuplugin.lua:40
msgid "Adds a firewall zone for UU's tunnel (tun16+) and lets the LAN forward into it. Required on OpenWrt 22.03 and newer, where forwarding is rejected by default - without it nothing can be boosted."
msgstr ""

#: luci-app-uugamebooster/luasrc/model/cbi/uuplugin.lua:47
msgid "Plugin build"
msgstr ""

