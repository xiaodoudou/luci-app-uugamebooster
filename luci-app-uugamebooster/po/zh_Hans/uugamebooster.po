#: luci-app-uugamebooster/luasrc/model/cbi/uuplugin.lua:26
msgid "UU Game Booster"
msgstr "UU 游戏加速器"

#: luci-app-uugamebooster/luasrc/model/cbi/uuplugin.lua:27
msgid "Runs NetEase's UU game accelerator on this router. See the <strong>How to use</strong> tab to get started."
msgstr "在本路由器上运行网易 UU 游戏加速器。请先查看<strong>使用方法</strong>选项卡。"

#: luci-app-uugamebooster/luasrc/model/cbi/uuplugin.lua:41
