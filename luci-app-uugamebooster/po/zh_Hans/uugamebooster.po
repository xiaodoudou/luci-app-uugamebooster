#: luci-app-uugamebooster/luasrc/view/uuplugin/uuplugin_status.htm:171
msgid "Only its TUN mode with auto-redirect is handled."
msgstr "只处理 TUN 模式加自动重定向的情况。"

#: luci-app-uugamebooster/luasrc/view/uuplugin/uuplugin_status.htm:215
msgid "Status"
msgstr "状态"

#: luci-app-uugamebooster/luasrc/view/uuplugin/uuplugin_status.htm:216
msgid "Collecting data..."
msgstr "正在获取数据…"
