msgstr "暂无 —— 请在 UU App 中选择要加速的设备"

#: luci-app-uugamebooster/luasrc/view/uuplugin/uuplugin_status.htm:142
msgid "left alone"
msgstr "未改动"

#: luci-app-uugamebooster/luasrc/view/uuplugin/uuplugin_status.htm:150
